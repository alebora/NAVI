# Robot identity
ROBOT_ID=bracketbot-189

# MongoDB. Leave blank to write completed summaries to data/outbox.
MONGODB_URI=
MONGODB_DATABASE=navi
MONGODB_COLLECTION=meetingSummaries

# Audio capture command. {path} is replaced with the output WAV path.
NAVI_RECORD_COMMAND=arecord -q -f S16_LE -c 1 -r 16000 {path}

# Optional local STT backends:
# WHISPER_CPP_BIN=/home/bracketbot/whisper.cpp/build/bin/whisper-cli
# WHISPER_CPP_MODEL=/home/bracketbot/models/ggml-tiny.en.bin

# Optional summarizer backends:
# OLLAMA_MODEL=qwen2.5:0.5b-instruct
# LLAMA_CPP_BIN=/home/bracketbot/llama.cpp/build/bin/llama-cli
# LLAMA_CPP_MODEL=/home/bracketbot/models/qwen2.5-0.5b-instruct-q4_k_m.gguf

# Optional status light command. Called with "blue" or "red".
# NAVI_LED_COMMAND=/home/bracketbot/NAVI/meeting_recording/jetson/set_led.sh
